# ABQ ADU platform server
PORT=4000
DATABASE_URL=postgres://localhost/abqadu

# InvoiceShelf back-office engine
INVOICESHELF_BASE_URL=http://localhost:8080
INVOICESHELF_API_TOKEN=
INVOICESHELF_COMPANY_ID=
INVOICESHELF_TIMEOUT_MS=12000
# Use the installed provider's USD currency ID and document template name.
# The company and linked customer currencies must also be USD with precision 2.
INVOICESHELF_CURRENCY_ID=
INVOICESHELF_TEMPLATE_NAME=
# Estimates have a separate template catalog from invoices.
INVOICESHELF_ESTIMATE_TEMPLATE_NAME=

# Stripe invoice payments (start with test credentials)
STRIPE_SECRET_KEY=
STRIPE_SUCCESS_URL=http://localhost:4000/payment-return
STRIPE_CANCEL_URL=http://localhost:4000/payment-return?result=cancelled
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Exact public HTTPS URL configured on this number for incoming messages (POST).
# Example: https://builder.example.com/api/contractor-desk/sms/inbound
# Signatures use this exact URL, never a forwarded Host header.
TWILIO_INBOUND_URL=

OCR_SPACE_API_KEY=

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated Clerk user IDs explicitly allowed into this shared workspace.
CLERK_ALLOWED_USER_IDS=
# Exact browser origins (scheme, host, port); no paths or trailing slashes.
APP_ORIGINS=http://localhost:4000,http://127.0.0.1:4000
# Optional Clerk PEM public key for networkless verification; escaped newlines are supported.
CLERK_JWT_KEY=

# Apple WeatherKit — server-side signing only. Requires WeatherKit-enabled
# Apple Developer Service ID/key. Store the downloaded .p8 key privately.
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
# PEM contents; escaped \n newlines are supported. Never send this to the browser.
WEATHERKIT_PRIVATE_KEY=
# JSON mapping of 5-digit ZIP -> {latitude,longitude,label,timeZone}.
# Set actual forecast coordinates; ZIP alone is not a WeatherKit location.
WEATHERKIT_LOCATIONS_JSON=
